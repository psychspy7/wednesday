# ─── Buddy AI Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.

# What you call the assistant
BUDDY_NAME=Buddy

# What it calls you
USER_NAME=Boss

# Default mood: funny | serious | savage | chill
MOOD=funny

# LLM provider: openai | ollama | litellm
LLM_PROVIDER=ollama

# Model name (e.g., llama3, gpt-4o, mistral)
LLM_MODEL=llama3

# OpenAI API key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama base URL (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# SerpAPI key (optional — falls back to DuckDuckGo)
SERPAPI_KEY=

# Voice input/output
VOICE_ENABLED=false

# Debug mode
DEBUG=false
